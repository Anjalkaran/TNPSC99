{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the TNPSC Ace app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user (matches Firebase Auth UID)."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "username": {
          "type": "string",
          "description": "Display name of the user."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Flag indicating if the user has admin privileges."
        },
        "createdAt": {
          "type": "string",
          "description": "The date and time the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "username"
      ]
    },
    "Question": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Question",
      "type": "object",
      "description": "Represents a multiple-choice question.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the question."
        },
        "text": {
          "type": "string",
          "description": "The text of the question."
        },
        "answerOptions": {
          "type": "array",
          "description": "Array of possible answer options.",
          "items": {
            "type": "string"
          }
        },
        "correctAnswer": {
          "type": "string",
          "description": "The string content of the correct answer."
        },
        "explanation": {
          "type": "string",
          "description": "Explanation for the correct answer."
        },
        "reference": {
          "type": "string",
          "description": "Reference to the source material (e.g., book, page)."
        },
        "subject": {
          "type": "string",
          "description": "The subject this question belongs to."
        },
        "topic": {
          "type": "string",
          "description": "The specific topic within the subject."
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "examType": {
          "type": "string",
          "enum": ["Group I", "Group II", "Group IV"],
          "description": "The TNPSC exam group this question is relevant for."
        }
      },
      "required": [
        "id",
        "text",
        "answerOptions",
        "correctAnswer"
      ]
    },
    "Test": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Test",
      "type": "object",
      "description": "Represents a collection of questions forming a test or quiz.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the test."
        },
        "title": {
          "type": "string",
          "description": "Title of the test."
        },
        "subject": {
          "type": "string",
          "description": "The main subject of the test."
        },
        "questionIds": {
          "type": "array",
          "description": "An array of question IDs that make up this test.",
          "items": {
            "type": "string"
          }
        },
        "totalQuestions": {
          "type": "number",
          "description": "The total number of questions in this test."
        },
        "duration": {
          "type": "number",
          "description": "The recommended duration for the test in minutes."
        },
        "createdAt": {
          "type": "string",
          "description": "The date and time the test was created.",
          "format": "date-time"
        },
        "isMockTest": {
          "type": "boolean",
          "description": "Flag to indicate if this is a full-length mock test."
        }
      },
      "required": [
        "id",
        "title",
        "questionIds",
        "totalQuestions"
      ]
    },
    "UserTestAttempt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserTestAttempt",
      "type": "object",
      "description": "Represents a user's attempt at a specific test.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the test attempt."
        },
        "testId": {
          "type": "string",
          "description": "Reference to the Test document."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the User who took the test."
        },
        "questionIds": {
          "type": "array",
          "description": "The ordered list of question IDs for this specific attempt.",
          "items": {
            "type": "string"
          }
        },
        "answers": {
          "type": "array",
          "description": "The user's answers, mapping index-wise to questionIds.",
          "items": {
            "type": "number"
          }
        },
        "score": {
          "type": "number",
          "description": "The final score for the attempt."
        },
        "status": {
          "type": "string",
          "enum": [
            "in-progress",
            "completed"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "testId",
        "userId",
        "questionIds",
        "answers",
        "status"
      ]
    },
    "Bookmark": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bookmark",
      "type": "object",
      "description": "Represents a user's bookmarked question.",
      "properties": {
        "id": {
          "type": "string"
        },
        "questionId": {
          "type": "string",
          "description": "Reference to the Question document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "questionId",
        "createdAt"
      ]
    },
    "LeaderboardScore": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LeaderboardScore",
      "type": "object",
      "description": "A single score entry for a specific test leaderboard.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "username",
        "score",
        "completedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/users/{userId}/testAttempts/{attemptId}",
        "definition": {
          "entityName": "UserTestAttempt",
          "schema": {
            "$ref": "#/backend/entities/UserTestAttempt"
          },
          "description": "Stores a user's attempt at a test. Owned by the user."
        }
      },
      {
        "path": "/users/{userId}/bookmarks/{bookmarkId}",
        "definition": {
          "entityName": "Bookmark",
          "schema": {
            "$ref": "#/backend/entities/Bookmark"
          },
          "description": "Stores a user's bookmarked questions."
        }
      },
      {
        "path": "/questions/{questionId}",
        "definition": {
          "entityName": "Question",
          "schema": {
            "$ref": "#/backend/entities/Question"
          },
          "description": "The central repository of all questions."
        }
      },
      {
        "path": "/tests/{testId}",
        "definition": {
          "entityName": "Test",
          "schema": {
            "$ref": "#/backend/entities/Test"
          },
          "description": "Defines a test, containing metadata and a list of question IDs."
        }
      },
      {
        "path": "/leaderboards/{testId}/scores/{scoreId}",
        "definition": {
          "entityName": "LeaderboardScore",
          "schema": {
            "$ref": "#/backend/entities/LeaderboardScore"
          },
          "description": "Stores individual scores for a specific test leaderboard."
        }
      }
    ],
    "reasoning": "This architecture separates data into logical, independent collections. It avoids data duplication by referencing documents (e.g., tests reference questions via IDs). Test attempts by users are stored in a subcollection under the user's document, which allows for clean, path-based security rules ensuring users can only access their own attempts. The use of a dedicated leaderboards collection allows for efficient querying of top scores without needing to read all user documents."
  }
}

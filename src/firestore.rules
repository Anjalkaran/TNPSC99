
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Simplest possible isAdmin check - avoid using this inside the User rule itself
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Data ---
    match /users/{userId} {
      // FIX: Check isOwner BEFORE isAdmin to prevent the recursive loop
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list, delete: if isAdmin();
      
      // Subcollections
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Tests Collection (The Mock Test Fix) ---
    match /tests/{testId} {
      allow get, list: if true;
      
      // Admins can create any test.
      // Users can only create tests that are marked as mock tests.
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.isMockTest == true);
      
      allow update: if isAdmin();

      // Admins can delete any test.
      // Users can only delete tests that are marked as mock tests.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.isMockTest == true);
    }

    // --- Question Bank ---
    match /questions/{questionId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
    }
    
    // --- App Metadata ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if true; allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- User Activity ---
    match /scores/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

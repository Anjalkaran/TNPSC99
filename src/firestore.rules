
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // defensive check
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 'isAdmin' in userData && userData.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    // This rule applies ONLY to the user document itself (e.g., /users/USER_ID)
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
    }

    // This rule applies to ALL documents in ALL subcollections under a user
    // (e.g., /users/USER_ID/testAttempts/ATTEMPT_ID)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }


    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- 4. QUESTION BANK (NOW SECURE) ---
    match /questions/{questionId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT (READ-ONLY FOR USERS) ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

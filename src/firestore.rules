
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Use exists() before get() to prevent errors
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      // Owner can read/write their own profile.
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Admins can read/write any user's profile.
      allow read, write: if isAdmin();

      // --- SUBCOLLECTION: testAttempts ---
      match /testAttempts/{attemptId} {
        // Owner can read, create, update, delete their own attempts.
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Explicitly check incoming data on create to ensure userId matches.
        allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
        
        // Admins have full access to all attempts.
        allow read, write: if isAdmin();
      }
      
      // --- SUBCOLLECTION: bookmarkedQuestions ---
      match /bookmarkedQuestions/{bookmarkId} {
        // Owner can read, create, update, delete their own bookmarks.
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && request.auth.uid == userId;

        // Admins have full access to all bookmarks.
        allow read, write: if isAdmin();
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }

    // --- 4. QUESTION BANK ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

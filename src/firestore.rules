
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read, write: if isAdmin();

      match /testAttempts/{attemptId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow read, write: if isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
        // Admins don't need separate bookmark rules, they can access via parent user doc rule.
      }
    }

    // --- 3. PUBLIC & ADMIN-WRITABLE CONTENT ---
    match /questions/{questionId} {
       allow read: if true;
       allow write: if isAdmin();
    }

    match /tests/{testId} {
       allow read: if true;
       allow write: if isAdmin();
    }
    
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if true; allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if true; allow write: if isAdmin(); }
    
    // --- 4. LEADERBOARDS & USER-GENERATED CONTENT ---
    match /leaderboards/{testId}/scores/{scoreId} {
       allow read: if true;
       // Allow signed-in users to create scores. A Cloud Function is recommended for security.
       allow create: if isSignedIn();
       allow update, delete: if isAdmin();
    }

    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

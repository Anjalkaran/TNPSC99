
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // SAFE isAdmin CHECK: First, verify the user document exists. This prevents
    // the entire rule evaluation from failing if the user document is missing.
    // This was the likely root cause of the persistent permission errors.
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Data ---
    match /users/{userId} {
      // Users can create their own profile.
      allow create: if isOwner(userId);
      // Users can read/update their own profile. Admins can read/update any.
      allow get, update: if isOwner(userId) || isAdmin();
      // Only admins can list or delete users.
      allow list, delete: if isAdmin();
      
      // Explicit rule for testAttempts to allow filtered queries by the owner.
      match /testAttempts/{attemptId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }

      // Explicit rule for bookmarks to allow filtered queries by the owner.
      match /bookmarkedQuestions/{bookmarkId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // --- Publicly Readable Content ---
    match /tests/{testId} {
      // Anyone can read tests, which is safe as they only contain metadata and question IDs.
      allow get, list: if true;
      
      // Allow users to create mock tests for themselves; admins can create any test.
      allow create: if (isSignedIn() && request.resource.data.isMockTest == true && request.resource.data.userId == request.auth.uid) || isAdmin();
      
      // Only admins can modify the main test bank.
      allow update: if isAdmin();

      // Admins can delete any test. Users can only delete their own mock tests.
      // Reverted to using get() as it was the previously working implementation.
      allow delete: if isAdmin() || (get(/databases/$(database)/documents/tests/$(testId)).data.isMockTest == true && get(/databases/$(database)/documents/tests/$(testId)).data.userId == request.auth.uid);
    }

    match /questions/{questionId} {
        // Any signed-in user can read questions. This is required for taking tests.
        allow get, list: if isSignedIn();
        // Only admins can modify the question bank.
        allow create, update, delete: if isAdmin();
    }
    
    // Other public collections
    match /classes/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /subjects/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /units/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /categories/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /syllabus/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /studyMaterials/{materialId} { allow get, list: if true; allow create, update, delete: if isAdmin(); }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      // Leaderboard is public.
      allow get, list: if true;
      // Users can only create scores for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only admins can modify scores.
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      // Any signed-in user can create/read comments.
      allow create, get, list: if isSignedIn();
      // Only admins can modify or delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

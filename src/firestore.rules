
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // --- User Profiles & Personal Data ---
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn(); // Allows user to create their own document on signup
      allow list: if isAdmin(); // Only admins can list all users

      // Allow access to own subcollections (scores, testAttempts, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Questions (Handles Collection Group Queries) ---
    // This recursive path is more robust.
    match /{path=**}/questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- Tests ---
    match /tests/{testId} {
      // Allow any signed-in user to create and read tests
      allow create, get, list: if isSignedIn();
      
      // Only admins can modify or delete the test bank
      allow update, delete: if isAdmin();
    }

    // --- General App Content ---
    match /classes/{id} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /subjects/{id} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /units/{id} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /categories/{id} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /syllabus/{id} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /studyMaterials/{materialId} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      // Leaderboard is public, but creation is protected.
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      // Any signed-in user can create/read comments.
      allow get, list, create: if isSignedIn();
      // Only admins can modify or delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

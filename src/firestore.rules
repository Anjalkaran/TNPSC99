
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Use exists() before get() to prevent errors
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      // Rules for the user document itself
      allow read, write: if request.auth.uid == userId;
      allow read, write: if isAdmin();

      // Rules for all subcollections (testAttempts, bookmarkedQuestions, etc.)
      match /{allPaths=**} {
        allow read, write: if request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 4. QUESTION BANK ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

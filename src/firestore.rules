
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // A safer isAdmin function that is less likely to fail on non-existent data.
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      // These rules apply to the user document itself.
      // Separate allow statements prevent the isAdmin() 'get' call from failing for the owner.
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin(); // Admins can manage user profiles.

      // --- SUBCOLLECTION: testAttempts ---
      match /testAttempts/{attemptId} {
        // Owner can read/write their own test attempts. This rule is simple and evaluated first.
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        // Admins can also read/write to any user's test attempts. This is evaluated only if the first rule fails.
        allow read, write: if isAdmin();
      }
      
      // --- SUBCOLLECTION: bookmarkedQuestions ---
      match /bookmarkedQuestions/{bookmarkId} {
        // Owner can read/write their own bookmarks.
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        // Admins can also read/write any user's bookmarks.
        allow read, write: if isAdmin();
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }

    // --- 4. QUESTION BANK ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

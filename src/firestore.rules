
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Safer isAdmin: Only call this if the UID check fails
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      // Allow the owner to do anything without calling the isAdmin function
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow Admins to access other users' data
      allow read, update, delete: if isAdmin();

      // Rule for all subcollections (testAttempts, bookmarkedQuestions, etc.)
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Only admins create/edit tests
    }

    // --- 4. QUESTION BANK ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Simplest possible isAdmin check - avoid using this inside the User rule itself
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Data ---
    match /users/{userId} {
      // FIX: Check isOwner BEFORE isAdmin to prevent the recursive loop
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list, delete: if isAdmin();
      
      // Subcollections
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Tests Collection (The Mock Test Fix) ---
    match /tests/{testId} {
      allow get, list: if true;
      
      // FIX: Simplified creation rule
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      
      allow update: if isAdmin();

      // FIX: Use 'resource' (current data) instead of 'get()' for deletion. 
      // This is much faster and more reliable.
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- Question Bank ---
    match /questions/{questionId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
    }
    
    // --- App Metadata ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if true; allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- User Activity ---
    match /scores/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

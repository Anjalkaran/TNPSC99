
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // SAFE a_is_admin CHECK: First, verify the user document exists. This prevents
    // the entire rule evaluation from failing if the user document is missing.
    // This was the likely root cause of the persistent permission errors.
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // --- User Data ---
    match /users/{userId} {
      // Users can create their own profile.
      allow create: if isOwner(userId);
      // Users can read/update their own profile. Admins can read/update any.
      allow get, update: if isOwner(userId) || isAdmin();
      // Only admins can list or delete users.
      allow list, delete: if isAdmin();
      
      // Rule for all subcollections under a user document.
      match /{allSubcollections=**} {
        // Users can read/write to their own subcollections (e.g., testAttempts, bookmarks).
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Publicly Readable Content ---
    // These collections contain public app data that anyone can read.
    // This is necessary for features to work for all users.
    match /tests/{testId} {
      // ANYONE can read the list of tests and individual test documents.
      // This is safe because tests only contain metadata and question IDs.
      // The actual questions are protected separately.
      allow get, list: if true;
      
      // Any SIGNED-IN user can create a new test (for generating a mock test).
      allow create: if isSignedIn();
      
      // Only admins can modify or delete the main test bank.
      allow update, delete: if isAdmin();
    }

    match /questions/{questionId} {
        // Any signed-in user can read questions. This is required for taking tests.
        allow get, list: if isSignedIn();
        // Only admins can modify the question bank.
        allow create, update, delete: if isAdmin();
    }
    
    match /classes/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /subjects/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /units/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /categories/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /syllabus/{id} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /studyMaterials/{materialId} { allow get, list: if true; allow create, update, delete: if isAdmin(); }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      // Leaderboard is public.
      allow get, list: if true;
      // Users can only create scores for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only admins can modify scores.
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      // Any signed-in user can create/read comments.
      allow create, get, list: if isSignedIn();
      // Only admins can modify or delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

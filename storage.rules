rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for study materials
    // Allow any authenticated user to read (download) files.
    // Allow any authenticated user to write (upload, update, delete) files.
    // The UI should restrict uploads to admins.
    match /study-materials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /reference-materials/{classId}/{subjectId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

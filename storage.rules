rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Study materials: Admins can write, signed-in users can read.
    match /study-materials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@tnpsc99.com';
    }
  }
}

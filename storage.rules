rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /reference-materials/{classId}/{subjectId}/{fileName} {
      allow read: if true;
      // TEMPORARY: Allow any authenticated user to write for debugging.
      allow write: if request.auth != null;
    }

    // deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

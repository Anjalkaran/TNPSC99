rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the caller is an administrator via Firestore
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.get('admin', false) == true) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'))
      );
    }

    // Textbook PDFs: All authenticated students and admins can read/view references
    // Only administrators can upload, overwrite, or delete textbook PDFs
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User-specific storage (e.g. avatars, user uploads if added)
    match /users/{userId}/{allUserPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}

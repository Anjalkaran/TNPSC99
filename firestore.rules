rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Most robust isAdmin check. Avoids errors if a user doc is missing.
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      // Allow user to write to their own subcollections (like testAttempts)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Mock Test Generation ---
    // Anyone signed in can read all questions and tests to generate a mock test.
    match /questions/{questionId} {
      allow read: if isSignedIn(); // read = get + list
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isSignedIn(); // read = get + list
      // ANY signed-in user can create a test. This is required for the client-side logic.
      allow create: if isSignedIn();
      // Only admins can modify or delete existing tests.
      allow update, delete: if isAdmin();
    }

    // --- Other Content Collections ---
    // These are read-only for users, writable by admins.
    match /classes/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      allow read: if true; // Public leaderboard
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only admins can resolve/delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

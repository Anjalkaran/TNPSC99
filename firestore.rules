/**
 * @file Firestore Security Rules for TNPSC Ace Application
 * @description This ruleset enforces a user-ownership model for user profiles, test attempts, and bookmarks,
 *              while allowing public read access to subjects, classes, questions, and tests.
 *              Admin users have write access to core content collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves. Admins can read any profile.
 * - /subjects/{subjectId}: Stores subject information, publicly readable. Writable by admins.
 * - /classes/{classId}: Stores class information, publicly readable. Writable by admins.
 * - /categories/{categoryId}: Stores category information, publicly readable. Writable by admins.
 * - /units/{unitId}: Stores unit information, publicly readable. Writable by admins.
 * - /questions/{questionId}: Stores question data, publicly readable. Writable by admins.
 * - /tests/{testId}: Stores test data, publicly readable. Writable by admins.
 * - /studymaterials/{materialId}: Stores study materials, publicly readable by authenticated users. Writable by admins.
 * - /users/{userId}/testAttempts/{testAttemptId}: Stores user's test attempts, accessible by the user and admins.
 * - /users/{userId}/bookmarkedQuestions/{bookmarkId}: Stores user's bookmarks, accessible only by the owner.
 * - /scores/{scoreId}: Publicly readable leaderboard scores. Writable only by the user who owns the score.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profiles, test attempts, and bookmarks.
 * - Admins can read all user data and write to content collections.
 * - Subjects, classes, questions, tests and study materials are publicly readable.
 * - Leaderboard scores are public, but can only be created by the user associated with the score.
 * - No user listing is allowed for non-admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdmin() {
      // Check if the requesting user is an admin by looking at their user document
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      // Users can read their own profile, admins can read any profile
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list users

      // Users can create their own profile
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Users can update their own profile, ensuring they don't grant themselves admin rights
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);
      
      // Admins can delete user profiles, users can delete their own
      allow delete: if isAdmin() || isExistingOwner(userId);

      match /testAttempts/{testAttemptId} {
        // Owner or admin can get a specific test attempt
        allow get: if isOwner(userId) || isAdmin();
        // Owner or admin can list test attempts for a user
        allow list: if isOwner(userId) || isAdmin();

        // Owner can create their own test attempt
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        // Owner can update their own test attempt
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        // Owner can delete their own test attempt
        allow delete: if isExistingOwner(userId);
      }
      
      match /bookmarkedQuestions/{bookmarkId} {
        // Owner can read their own bookmarks
        allow get, list: if request.auth.uid == userId;
        // Owner can create and delete bookmarks that belong to them
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
        // Bookmarks are not updatable
        allow update: if false;
      }
    }
    
    match /scores/{scoreId} {
      // Leaderboard is public
      allow get, list: if true;
      // Users can only create their own scores
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Scores cannot be updated or deleted by clients
      allow update, delete: if false;
    }

    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /units/{unitId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studymaterials/{materialId} {
      // Any authenticated user can read
      allow get, list: if request.auth != null;
      // Only admins can write/delete
      allow create, update, delete: if isAdmin();
    }
  }
}

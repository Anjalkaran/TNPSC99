
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is admin WITHOUT causing a circular loop
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn(); // Allow creation if signed in
      allow update, delete: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /questions/{questionId} {
      // USERS MUST BE ABLE TO READ QUESTIONS TO GENERATE A TEST
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      // 1. Anyone signed in can read tests
      allow read: if isSignedIn();
      
      // 2. Allow creation if it's a mock test OR the user is an admin
      // IMPORTANT: The code creating the test MUST include isMockTest: true
      allow create: if isSignedIn() && (
        request.resource.data.isMockTest == true || 
        isAdmin()
      );
      
      allow update, delete: if isAdmin();
    }

    // Common Collections (Read for users, write for admins)
    match /classes/{classId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjects/{subjectId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /units/{unitId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{categoryId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{syllabusId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{materialId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /questionComments/{commentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // The following rules are for legacy collections and should not be needed for new functionality.
    // They are kept here for reference but the catch-all below is more future-proof.
    match /classTests/{classTestId} { allow read: if isSignedIn(); allow write: if false; }
    match /subjectTests/{subjectTestId} { allow read: if isSignedIn(); allow write: if false; }
    match /previousYearPapers/{paperId} { allow read: if isSignedIn(); allow write: if false; }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Safer isAdmin: Only call this if the user is NOT the owner of the document
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA & SUBCOLLECTIONS ---
    match /users/{userId} {
      // 1. If you are the owner, ALLOW. (No isAdmin check here)
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // 2. If you are NOT the owner, check if you are an Admin
      allow read, update, delete: if request.auth.uid != userId && isAdmin();

      // Rule for all subcollections (testAttempts, bookmarkedQuestions, etc.)
      match /{allPaths=**} {
        // Owner can do anything in their own subcollections.
        // This rule will match first and grant access without calling isAdmin().
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        
        // Admins can do anything in any user's subcollections.
        // This rule is only evaluated if the first one doesn't match.
        allow read, write: if isAdmin();
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }

    // --- 4. QUESTION BANK ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Improved isAdmin: Uses a safer check that won't fail if the doc is missing
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles & Personal Data ---
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn();

      // Allow access to all subcollections (scores, testAttempts, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Mock Test Generation & Core Content ---
    match /questions/{questionId} {
      // USERS MUST BE ABLE TO READ AND LIST QUESTIONS TO GENERATE A TEST
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      // Allow any signed-in user to create a test (for mock tests)
      // and read/list existing tests.
      allow create, get, list: if isSignedIn();
      
      // Only admins can modify or delete existing test banks.
      allow update, delete: if isAdmin();
    }

    // --- General Read-Only Content for Users ---
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /units/{unitId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
     match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /syllabus/{syllabusId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /studyMaterials/{materialId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      // Leaderboard is public, but creation is protected.
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      // Any signed-in user can create/read comments.
      allow get, list, create: if isSignedIn();
      // Only admins can modify or delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

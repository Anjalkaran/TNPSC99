
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')) ||
        request.auth.token.email.matches('.*@tnpsc99\\.com$')
      );
    }

    // Rules for the users collection and its subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // Explicit rule for testAttempts subcollection
      match /testAttempts/{attemptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Explicit rule for bookmarkedQuestions subcollection
      match /bookmarkedQuestions/{questionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Catch-all for any other subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Rules for top-level collections
    match /tests/{testId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /syllabus/{syllabusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /studyMaterials/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /questionComments/{id} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
        allow write: if isAdmin();
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    // This helper is ONLY called if the user is NOT the owner
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- 2. USER DATA (CRITICAL FIX) ---
    match /users/{userId} {
      // Check ownership FIRST. If this is true, isAdmin() is never called.
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      // Only call isAdmin if the user is NOT the owner
      allow read, write: if isAdmin();

      // Subcollections (testAttempts, scores, bookmarks)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read, list: if isSignedIn();
      
      // Allow creation if the user is signed in. 
      // We rely on the userId field in the data for ownership.
      allow create: if isSignedIn();
      
      // Allow update/delete if owner OR admin
      allow update, delete: if isSignedIn() && (
        (exists(resource.data.userId) && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
    }

    // --- 4. QUESTION BANK (TEMPORARILY UNSECURED FOR MIGRATION) ---
    match /questions/{questionId} {
      allow read, list: if true; // WARNING: This is for migration script access.
      allow write: if true; // WARNING: This is for migration script access. Should be changed back to 'if isAdmin();'
    }

    // --- 5. APP CONTENT (READ-ONLY FOR USERS) ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

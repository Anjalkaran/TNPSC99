
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // --- 2. USER DATA ---
    match /users/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();

      // User-owned subcollections
      match /testAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /bookmarkedQuestions/{bookmarkId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // --- 3. TESTS COLLECTION ---
    match /tests/{testId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- 4. QUESTION BANK (NOW SECURE) ---
    match /questions/{questionId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 5. APP CONTENT (READ-ONLY FOR USERS) ---
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /units/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /syllabus/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // --- 6. USER GENERATED CONTENT ---
    match /scores/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}

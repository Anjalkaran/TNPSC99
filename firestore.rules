
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // A safer check that ensures the user document exists before trying to read a field from it.
    // This prevents errors for users who might not have an `isAdmin` field.
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles & Subcollections ---
    match /users/{userId} {
      // A user can read and write to their own profile. An admin can read/write any profile.
      allow read, write: if isOwner(userId) || isAdmin();

      // This covers subcollections like /testAttempts, /bookmarkedQuestions etc.
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Mock Test Generation & Core Content ---
    match /questions/{questionId} {
      // Any signed-in user must be able to read questions to generate a test.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      // Any signed-in user can create a test (for mock tests) and read any test.
      allow create, read: if isSignedIn();
      // Only admins can modify or delete existing test banks.
      allow update, delete: if isAdmin();
    }

    // --- General Read-Only Content for Users ---
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
     match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /syllabus/{syllabusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /studyMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- User-Generated Content ---
    match /scores/{scoreId} {
      // Leaderboard is public, but creation is protected.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /questionComments/{commentId} {
      // Any signed-in user can create/read comments.
      allow read, create: if isSignedIn();
      // Only admins can modify or delete comments.
      allow update, delete: if isAdmin();
    }
  }
}

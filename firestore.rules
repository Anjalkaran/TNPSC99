rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('admin', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'))
      );
    }

    // Sensitive profile keys that regular users are forbidden from creating or updating
    function hasNoPrivilegeEscalationOnCreate() {
      let data = request.resource.data;
      return (!data.keys().hasAny(['isAdmin', 'admin']) || data.get('isAdmin', false) == false)
          && (!data.keys().hasAny(['role']) || data.get('role', 'student') in ['student', 'user'])
          && (!data.keys().hasAny(['subscriptionStatus']) || data.get('subscriptionStatus', 'free') == 'free')
          && (!data.keys().hasAny(['subscriptionExpires']) || data.get('subscriptionExpires', null) == null)
          && (!data.keys().hasAny(['aiCredits']) || data.get('aiCredits', 0) == 0)
          && (!data.keys().hasAny(['lastPaymentId', 'lastOrderId']));
    }

    function hasNoPrivilegeEscalationOnUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return !diff.hasAny([
        'isAdmin', 
        'admin', 
        'role', 
        'subscriptionStatus', 
        'subscriptionExpires', 
        'aiCredits', 
        'lastPaymentId', 
        'lastOrderId'
      ]);
    }

    // --- Users Collection & Subcollections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow initial registration if sensitive keys are not elevated
      allow create: if isOwner(userId) && hasNoPrivilegeEscalationOnCreate();
      
      // Allow updating standard profile attributes (displayName, phoneNumber, language, etc.)
      // Prevent privilege escalation
      allow update: if (isOwner(userId) && hasNoPrivilegeEscalationOnUpdate()) || isAdmin();
      
      allow delete: if isAdmin();

      // Student attempt logs (owned by student, authoritative finalization via server API only)
      match /testAttempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        
        // Students can only create in-progress attempts for themselves with score: 0
        allow create: if (
          isOwner(userId) &&
          request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('status', 'in-progress') == 'in-progress' &&
          request.resource.data.get('score', 0) == 0 &&
          !request.resource.data.keys().hasAny([
            'completedAt', 
            'correctlyAnsweredQuestionIds', 
            'incorrectlyAnsweredQuestionIds'
          ]) &&
          // New Exam Mode attempts MUST provide examDeadlineMillis (cannot omit)
          (request.resource.data.get('mode', 'practice') != 'exam' ||
           request.resource.data.keys().hasAll(['examDeadlineMillis'])) &&
          // Exam deadline must not be in past and cannot exceed authorized duration
          (!request.resource.data.keys().hasAny(['examDeadlineMillis']) ||
           (
             request.resource.data.get('durationMinutes', 30) > 0 &&
             request.resource.data.get('durationMinutes', 30) <= 180 &&
             request.resource.data.get('examDeadlineMillis', 0) >= request.time.toMillis() &&
             request.resource.data.get('examDeadlineMillis', 0) <= request.time.toMillis() + (request.resource.data.get('durationMinutes', 30) * 60 * 1000) + 5000
           ))
        ) || isAdmin();

        // Students can ONLY update in-progress state (answers, currentQuestionIndex, markedForReviewIds, timeSpentSeconds)
        // Students CANNOT complete, rescore, alter deadlines, or tamper with authoritative fields directly
        // ZERO TOLERANCE: No late answer can be saved after deadline (strictly request.time.toMillis() <= examDeadlineMillis)
        allow update: if (
          isOwner(userId) &&
          resource.data.get('status', 'in-progress') == 'in-progress' &&
          request.resource.data.get('status', 'in-progress') == 'in-progress' &&
          (
            resource.data.get('mode', 'practice') != 'exam' ||
            !resource.data.keys().hasAny(['examDeadlineMillis']) ||
            request.time.toMillis() <= resource.data.examDeadlineMillis
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'mode',
            'status', 
            'score', 
            'completedAt', 
            'correctlyAnsweredQuestionIds', 
            'incorrectlyAnsweredQuestionIds',
            'examDeadline',
            'examDeadlineMillis',
            'startedAt',
            'durationMinutes'
          ])
        ) || isAdmin();

        // Once completed, attempts cannot be deleted by students
        allow delete: if (isOwner(userId) && resource.data.get('status', 'in-progress') == 'in-progress') || isAdmin();
      }

      // Student Mistake Vault (authoritative writes derived strictly from trusted completed attempts)
      match /mistakeVault/{questionId} {
        allow read: if isOwner(userId) || isAdmin();
        // Prevent direct student writes from forging mastery states, resolvedAt, or failureCount
        allow write: if isAdmin();
      }

      // Student bookmarks (owned by student)
      match /bookmarkedQuestions/{questionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Read-only audit log of credits (only admin/functions can write)
      match /credit_ledger/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // --- Payment Records Collection (Audit Trail) ---
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- Tests Collection ---
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
    }

    // --- Question Bank (Protected from unauthenticated scraping) ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Curriculum & Metadata Collections ---
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /syllabus/{syllabusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /studyMaterials/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboard Scores: Authoritative writes only via server finalization API
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questionComments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
    }

    // --- Current Affairs Intelligence Engine Collections ---
    // Published questions are readable by authenticated students; drafts/review items are Admin only
    match /currentAffairsQuestions/{questionId} {
      allow read: if (isSignedIn() && resource.data.get('status', '') == 'PUBLISHED') || isAdmin();
      allow write: if isAdmin();
    }

    match /ca_manifests/{manifestId} {
      allow read: if (isSignedIn() && resource.data.get('status', '') == 'published') || isAdmin();
      allow write: if isAdmin();
    }

    // Engine internal pipeline staging collections (Strictly Admin / Server Worker only)
    match /ca_sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    match /ca_raw_documents/{docId} {
      allow read, write: if isAdmin();
    }

    match /ca_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /ca_draft_questions/{draftId} {
      allow read, write: if isAdmin();
    }

    match /ca_reviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /ca_pipeline_runs/{runId} {
      allow read, write: if isAdmin();
    }
  }
}

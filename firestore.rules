
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check for the existence of the user document and the isAdmin flag
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users
      allow create: if isOwner(userId); // A user can create their own profile
      allow update: if isOwner(userId) || isAdmin(); // A user or an admin can update a profile
      allow delete: if isOwner(userId) || isAdmin(); // A user can delete their own profile, or an admin can

      // Subcollections for a user
      match /scores/{scoreId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /testAttempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /bookmarkedQuestions/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // App Content collections (read-only for users, writable for admins)
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /subjects/{subjectId} {
      allow read, write: if true;
    }
    
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /units/{unitId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /tests/{testId} {
      allow read, write: if true;
    }

    // Public scores for leaderboard
    match /scores/{scoreId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false; // Scores shouldn't be updated or deleted by clients
    }
    
    match /questionComments/{commentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete, list: if isAdmin();
    }

    // Legacy collections, keep as read-only for signed-in users
    match /classTests/{classTestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subjectTests/{subjectTestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /previousYearPapers/{previousYearPaperId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
